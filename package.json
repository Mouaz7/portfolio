{
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "next": "16.4.5",
    "nodemailer": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "knip": "6.44.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "zod": "4.6.6",
    "postcss": "8.5.32",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  },
  "license": "UNLICENSED",
  "name": "mouaz-naji-portfolio",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "chrome 105",
    "edge 105",
    "firefox 115",
    "safari 15.4",
    "ios_saf 15.4",
    "samsung 20"
  ],
  "scripts": {
    "prebuild": "node scripts/build-legacy-css.mjs",
    "build": "next build --webpack",
    "dev": "node scripts/run-dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:dead": "knip",
    "sync:projects": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-projects-from-github.mts",
    "start": "next start",
    "test": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:csp-report-only": "node scripts/inspect-csp-report-only.mjs",
    "test:coverage": "jest --coverage",
    "test:design-lock": "node scripts/check-design-lock.mjs",
    "test:pixel-lock": "node scripts/check-pixel-lock.mjs",
    "test:visual-compare": "node scripts/compare-visual.mjs",
    "test:lighthouse": "node scripts/run-lighthouse-ci.mjs",
    "test:licenses": "node scripts/audit-dependency-licenses.mjs",
    "test:motion-performance": "node scripts/measure-motion-performance.mjs",
    "test:navigation-performance": "node scripts/measure-navigation-performance.mjs",
    "test:secrets": "bash scripts/scan-git-history.sh",
    "test:secrets:gitleaks": "bash scripts/run-gitleaks-history.sh",
    "test:e2e": "playwright test",
    "verify": "eslint . --max-warnings=0 && tsc --noEmit && knip && npm run test:design-lock && npm run test:ci",
    "verify:full": "npm run verify && npm run build && npm run test:e2e"
  },
  "version": "0.1.0",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
